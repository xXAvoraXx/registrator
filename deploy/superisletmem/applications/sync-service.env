# Merge these keys into the existing Dokploy application environment.
CONSUL_ADDRESS=http://consul-agent-application:8500
SERVICE_8080_IGNORE=false
SERVICE_8080_NAME=sync-service
SERVICE_8080_TAGS=production,critical,secure=false
